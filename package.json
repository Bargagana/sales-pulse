{
  "name": "sales-pulse",
  "version": "0.1.0",
  "scripts": {
    "test": "vitest run",
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "node scripts/check-node.mjs && vite build && tsx server/index.ts --static",
    "test:e2e": "vite build && playwright test",
    "test:all": "npm run typecheck && vitest run && npm run test:e2e",
    "typecheck": "tsc --noEmit -p ."
  },
  "license": "UNLICENSED",
  "type": "module",
  "private": "true",
  "dependencies": {
    "@highcharts/map-collection": "^2.3.3",
    "@hono/node-server": "^2.1.11",
    "apexcharts": "^8.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "highcharts": "^13.1.1",
    "highcharts-react-official": "^3.2.3",
    "hono": "^4.13.21",
    "i18next": "^27.2.4",
    "lucide-react": "^1.78.0",
    "papaparse": "^5.7.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-apexcharts": "^2.2.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
